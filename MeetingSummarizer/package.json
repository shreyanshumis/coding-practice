{
  "name": "meeting-summarizer",
  "private": true,
  "version": "0.1.0",
  "scripts": {
    "dev": "concurrently -k -n API,WEB -c blue,magenta \".venv\\Scripts\\python.exe -m uvicorn backend.app.main:app --reload --port 8000\" \"npm --prefix frontend run dev\"",
    "dev:frontend": "npm --prefix frontend run dev",
    "dev:backend": ".venv\\Scripts\\python.exe -m uvicorn backend.app.main:app --reload --port 8000",
    "build": "npm --prefix frontend run build",
    "lint": "npm --prefix frontend run lint",
    "test": ".venv\\Scripts\\python.exe -m unittest discover -s tests -v",
    "install:frontend": "npm --prefix frontend install",
    "install:backend": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/install-backend.ps1"
  },
  "devDependencies": {
    "concurrently": "10.0.5"
  }
}
